KERNEL_ARCH_GDT_CFLAGS = $(KERNEL_ARCH_CFLAGS)
KERNEL_ARCH_GDT_CPPFLAGS = $(KERNEL_ARCH_CPPFLAGS)
KERNEL_ARCH_GDT_LDFLAGS = $(KERNEL_ARCH_LDFLAGS)
KERNEL_ARCH_GDT_LIBS = $(KERNEL_ARCH_LIBS)

KERNEL_ARCH_GDT_OBJS = \
        $(ARCH_GDT_DIR)/gdt.o \
        $(ARCH_GDT_DIR)/gdt_asm.o \

KERNEL_ARCH_GDT_EPHEM =

$(ARCH_GDT_DIR)/%.o: $(ARCH_GDT_DIR)/%.c
	$(CC) -MD -c $< -o $@ -std=gnu23 $(KERNEL_ARCH_GDT_CFLAGS) $(KERNEL_ARCH_GDT_CPPFLAGS)

