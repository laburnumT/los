KERNEL_ARCH_INTERRUPT_CFLAGS = $(KERNEL_ARCH_CFLAGS)
KERNEL_ARCH_INTERRUPT_CPPFLAGS = $(KERNEL_ARCH_CPPFLAGS)
KERNEL_ARCH_INTERRUPT_LDFLAGS = $(KERNEL_ARCH_LDFLAGS)
KERNEL_ARCH_INTERRUPT_LIBS = $(KERNEL_ARCH_LIBS)

KERNEL_ARCH_INTERRUPT_OBJS = \
        $(ARCH_INTERRUPT_DIR)/idt.o \
        $(ARCH_INTERRUPT_DIR)/interrupt.o \
        $(ARCH_INTERRUPT_DIR)/interrupt_asm.o \
        $(ARCH_INTERRUPT_DIR)/interrupt_asm_auto.o \
        $(ARCH_INTERRUPT_DIR)/pic.o \

KERNEL_ARCH_INTERRUPT_EPHEM = \
        $(ARCH_INTERRUPT_DIR)/interrupt_asm_auto.s

$(ARCH_INTERRUPT_DIR)/interrupt_asm_auto.s: $(ARCH_INTERRUPT_DIR)/scripts/gen_interrupt_asm.py
	$< > $@

$(ARCH_INTERRUPT_DIR)/%.o: $(ARCH_INTERRUPT_DIR)/%.c
	$(CC) -MD -c $< -o $@ -std=gnu23 $(KERNEL_ARCH_INTERRUPT_CFLAGS) $(KERNEL_ARCH_INTERRUPT_CPPFLAGS)

# vim: ft=make
