KERNEL_ARCH_CFLAGS = $(CFLAGS)
KERNEL_ARCH_CPPFLAGS = $(CPPFLAGS) -I$(ARCHDIR)/include
KERNEL_ARCH_LDFLAGS = $(LDFLAGS)
KERNEL_ARCH_LIBS = $(LIBS)

ARCH_INTERRUPT_DIR = $(ARCHDIR)/interrupt

include $(ARCH_INTERRUPT_DIR)/make.config

KERNEL_ARCH_OBJS = \
        $(ARCHDIR)/boot.o \
        $(ARCHDIR)/gdt.o \
        $(ARCHDIR)/gdt_asm.o \
        $(ARCHDIR)/init.o \
        $(ARCHDIR)/panic.o \
        $(ARCHDIR)/port.o \
        $(ARCHDIR)/ps2.o \
        $(ARCHDIR)/tty.o \
        $(KERNEL_ARCH_INTERRUPT_OBJS)

KERNEL_ARCH_EPHEM = \
        $(KERNEL_ARCH_INTERRUPT_EPHEM) \

$(ARCHDIR)/crtbegin.o $(ARCHDIR)/crtend.o:
	OBJ=`$(CC) $(KERNEL_ARCH_CFLAGS) $(KERNEL_ARCH_LDFLAGS) -print-file-name=$(@F)` && cp "$$OBJ" $@

$(ARCHDIR)/%.o: $(ARCHDIR)/%.c
	$(CC) -MD -c $< -o $@ -std=gnu23 $(KERNEL_ARCH_CFLAGS) $(KERNEL_ARCH_CPPFLAGS)


# vim: ft=make
